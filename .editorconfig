root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{md,json,yml,yaml}]
end_of_line = lf
indent_style = space
indent_size = 2

[*.py]
end_of_line = lf
indent_style = space
indent_size = 4

[*.{ps1,psm1}]
indent_style = space
indent_size = 4

[*.{cmd,bat}]
indent_style = space
indent_size = 2
