# 统一换行与二进制判定，避免 Windows/Linux 混合编辑导致整文件 diff
* text=auto

*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.py   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.txt  text eol=lf

*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.exe binary

.gitignore     text eol=lf
.gitattributes text eol=lf
.editorconfig  text eol=lf
