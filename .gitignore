# ============================================================
# PowerFocus git 忽略规则
# 原则：源码与配置入库，运行态、日志、产物、密钥一律不入库
# ============================================================

# ---- 运行时日志与状态 ----
logs/
out/
*.log
*.lock
*.pid
**/rules_state.json
**/*heartbeat*.json
**/v2_heartbeat.json

# ---- 命令总线（只保留 README 与示例） ----
/commands/in/
/commands/out/
/commands/done/
/v2/commands/
/v3/commands/

# ---- 回滚运行时记录 ----
/v3/rollback/*.json
/v3/rollback/*.log

# ---- 密钥与令牌（绝不入库） ----
.auth_token
**/.auth_token
*.token
*.secret
*.key

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
.dev/

# ---- 编辑器与系统 ----
.vscode/
.idea/
Thumbs.db
desktop.ini

# ---- 归档与模型大文件（模型本体在 E:\Model_Zone，不在本仓） ----
archive/*.zip
archive/*.7z
archive/**/*.png
archive/**/*.log
*.gguf
*.safetensors

# ---- 带时间戳的本地备份（留档用，不入库） ----
*.bak-[0-9]*

# 2026-11-12 修复操作的原文件备份（留档可还原，不入库）
archive/desktop-fix-*/

# ---- 2026-11-12 补：旧规则漏网项（提交前实测 git check-ignore 发现） ----
# 文件名是 .model_key，不以 .key 结尾，上面的 *.key 匹配不到
.model_key
**/.model_key
# 打包产物与根目录一次性扫描结果，属产物不属源码
product/**/dist/
product/**/build/pyi/
/_*.txt
/_model-scan-roots.json
# 归档与版本目录内的旧命令总线运行态（旧规则只挡根 v2/v3，这两处漏网）
archive/**/commands/
v2-archive/**/commands/
versions/**/commands/

# ---- 2026-11-12 V0.10：KVRT 引擎二进制与扫描运行态（绝不入库） ----
# KVRT EULA 5.4 禁止随第三方产品分发；这里只入库下载/验签/调用的源码，
# 引擎 exe 由用户在使用时主动从官方源下载到本机应用目录。
versions/**/engines/
versions/**/engine.json
versions/**/reports/KVRT_Data/
versions/**/reports/scan-*.json
versions/**/reports/scan-*.json.bak
versions/**/reports/scan-*.log
versions/**/reports/real-scan-console.log
versions/**/reports/bootstrap-*.json
versions/**/scan_settings.json
*.part

# PyInstaller 打包日志（本地构建留档，不入库）
product/v1.00/build/pack-log-*.txt
