# ============================================================
# PowerFocus git 忽略规则
# 原则：源码与配置入库，运行态、日志、产物、密钥一律不入库
# ============================================================

# ---- 运行时日志与状态 ----
logs/
out/
*.log
*.lock
*.pid
**/rules_state.json
**/*heartbeat*.json
**/v2_heartbeat.json

# ---- 命令总线（只保留 README 与示例） ----
/commands/in/
/commands/out/
/commands/done/
/v2/commands/
/v3/commands/

# ---- 回滚运行时记录 ----
/v3/rollback/*.json
/v3/rollback/*.log

# ---- 密钥与令牌（绝不入库） ----
.auth_token
**/.auth_token
*.token
*.secret
*.key

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
.dev/

# ---- 编辑器与系统 ----
.vscode/
.idea/
Thumbs.db
desktop.ini

# ---- 归档与模型大文件（模型本体在 E:\Model_Zone，不在本仓） ----
archive/*.zip
archive/*.7z
archive/**/*.png
archive/**/*.log
*.gguf
*.safetensors

# ---- 带时间戳的本地备份（留档用，不入库） ----
*.bak-[0-9]*

# 2026-11-12 修复操作的原文件备份（留档可还原，不入库）
archive/desktop-fix-*/

# ---- 2026-11-12 补：旧规则漏网项（提交前实测 git check-ignore 发现） ----
# 文件名是 .model_key，不以 .key 结尾，上面的 *.key 匹配不到
.model_key
**/.model_key
# 打包产物与根目录一次性扫描结果，属产物不属源码
product/**/dist/
product/**/build/pyi/
/_*.txt
/_model-scan-roots.json
# 归档与版本目录内的旧命令总线运行态（旧规则只挡根 v2/v3，这两处漏网）
archive/**/commands/
v2-archive/**/commands/
versions/**/commands/

# ---- 2026-11-12 V0.10：KVRT 引擎二进制与扫描运行态（绝不入库） ----
# KVRT EULA 5.4 禁止随第三方产品分发；这里只入库下载/验签/调用的源码，
# 引擎 exe 由用户在使用时主动从官方源下载到本机应用目录。
versions/**/engines/
versions/**/engine.json
versions/**/reports/KVRT_Data/
versions/**/reports/scan-*.json
versions/**/reports/scan-*.json.bak
versions/**/reports/scan-*.log
versions/**/reports/real-scan-console.log
versions/**/reports/bootstrap-*.json
versions/**/scan_settings.json
*.part

# PyInstaller 打包日志（本地构建留档，不入库）
product/v1.00/build/pack-log-*.txt

# ---- 2026-11-14 补：v3 重新打包前的旧版 exe 本地备份（20 MB 二进制，不入库） ----
product/**/dist-v3/

# ---- 2026-11-14 补：开源合规审查（运行态 state 与本机诊断快照） ----
# 内核每次运行都覆写 mem-guard.state.json，历史上 6 个副本被 git 跟踪，
# 导致「一运行就脏工作区」且运行数据随 clone 分发；已从索引移除并忽略。
**/mem-guard.state.json
# 本机诊断快照含开发机用户名、绝对路径与无关项目目录。已入仓的历史副本
# 是否从索引移除属需授权的仓库变更，此处只挡住今后新增的副本。
archive/diagnostics-*/

# 本机私有模型清单（通用化）：内置 models-preset.ini 是模板，
# 各机器自己的模型路径写在这里，绝不提交私有绝对路径。
models-preset.local.ini
**/models-preset.local.ini

# 开发机诊断归档仅保留本地，不入库（含本机路径，勿提交）
archive/
